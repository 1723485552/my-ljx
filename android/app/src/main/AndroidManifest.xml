<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限：用于即时轻量翻译请求 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 悬浮窗权限：允许在任意 App 界面顶层弹出提示 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 后台前台常驻服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 13+ 图片读取权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 12 及以下兼容权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Android 11+ 全部文件管理（用于 100% 免弹窗静默删除引导） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="NovaToolBox"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.NovaToolBox">

        <!-- 截屏后台监听服务 -->
        <service
            android:name=".features.screenshot.data.ScreenshotWatcherService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- 跨应用呼起系统删除弹窗的透明中转 Activity -->
        <activity
            android:name=".features.screenshot.data.TransparentDeleteActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />

        <!-- 原生 Compose 导航宿主 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NovaToolBox"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 文件导出共享（MoodHeatmap CSV 导出） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
